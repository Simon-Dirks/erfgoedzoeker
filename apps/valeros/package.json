{
  "name": "@valeros/app",
  "version": "0.17.0",
  "private": true,
  "imports": {
    "#styles.css": "./src/styles.css"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "graphql-codegen": "graphql-codegen --config codegen.ts",
    "test:unit": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"e2e/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"e2e/**/*.ts\" \"*.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/feather-icons": "^36.1.0",
    "@valeros/config-schema": "workspace:*",
    "@valeros/icon-registry": "workspace:*",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "1.5.3",
    "mirador": "^4.2.6",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.0",
    "tify": "^0.36.2",
    "tslib": "^2.3.0",
    "universalviewer": "^4.4.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "daisyui": "^5.7.47",
    "mermaid": "12.1.0",
    "postcss": "^8.5.9",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}

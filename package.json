{
  "name": "valeros-workspace",
  "private": true,
  "version": "0.13.0",
  "imports": {
    "#styles.css": "./src/styles.css"
  },
  "scripts": {
    "start": "pnpm --filter @valeros/app run start",
    "build": "pnpm --filter @valeros/app run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "generate:config-schema": "pnpm --filter @valeros/config-schema run generate:config-schema",
    "test:unit": "pnpm --filter @valeros/app run test:unit",
    "test:e2e": "pnpm --filter @valeros/app run test:e2e",
    "test:e2e:install": "pnpm --filter @valeros/app run test:e2e:install",
    "format": "pnpm --filter @valeros/app run format",
    "configurator:dev": "pnpm --filter @valeros/configurator run dev",
    "configurator:build": "pnpm --filter @valeros/configurator run build"
  },
  "devDependencies": {
    "vitepress": "^1.5.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.43",
    "mermaid": "12.0.0"
  },
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
